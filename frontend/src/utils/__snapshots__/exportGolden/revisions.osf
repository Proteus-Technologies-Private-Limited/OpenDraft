      <para scene_number="1">
        <style basestylename="Scene Heading"/>
        <text>INT. OFFICE - DAY</text>
      </para>
      <para>
        <style basestylename="Action"/>
        <text>The phone rings. </text>
        <text>Nobody answers it.</text>
        <marks><mark at="0" revision="1"/></marks>
      </para>
      <para>
        <style basestylename="Character"/>
        <text>BOSS</text>
      </para>
      <para>
        <style basestylename="Dialogue"/>
        <text>Somebody get that.</text>
        <marks><mark at="0" revision="1"/></marks>
