  <paragraphs>
      <para scene_number="1">
        <style basestylename="Scene Heading"/>
        <text>EXT. STREET - NIGHT</text>
      </para>
      <para>
        <style basestylename="Action"/>
        <text>Two people talk over each other.</text>
      </para>
      <para>
        <style basestylename="Character" dualdialogue="1"/>
        <text>MARA</text>
      </para>
      <para>
        <style basestylename="Dialogue" dualdialogue="1"/>
        <text>We should go before it gets dark out there tonight.</text>
      </para>
      <para>
        <style basestylename="Character" dualdialogue="1"/>
        <text>JONAH</text>
      </para>
      <para>
        <style basestylename="Dialogue" dualdialogue="1"/>
        <text>Not until the others are back.</text>
      </para>
      <para>
        <style basestylename="Character"/>
        <text>MARA</text>
      </para>
      <para>
        <style basestylename="Dialogue"/>
        <text>Fine.</text>
      </para>
      <para>
        <style name="Normal Text" label="Normal Text" font="Courier" size="12"/>
        <text></text>
      </para>
  </paragraphs>
