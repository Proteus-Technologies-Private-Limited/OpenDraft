  <TitlePage>
    <Content>
    </Content>
  </TitlePage>

  <Content>
    <Paragraph Type="Scene Heading" Number="1">
      <Text>SCENE 1</Text>
    </Paragraph>
    <Paragraph Type="Sound Effect">
      <Text>SFX: WAVES CRASHING ON A ROCKY SHORE.</Text>
    </Paragraph>
    <Paragraph Type="Music Cue">
      <Text>MUSIC: SLOW STRINGS, SOMBER.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NARRATOR</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>On a cold morning in October...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Who is there?</Text>
    </Paragraph>
    <Paragraph Type="Sound Effect">
      <Text>SFX: A DOOR CREAKS.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" Number="2">
      <Text>SCENE 2</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>JONAH</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Only me.</Text>
    </Paragraph>
  </Content>
</FinalDraft>