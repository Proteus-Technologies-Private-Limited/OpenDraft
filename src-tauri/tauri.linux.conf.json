      { "ext": ["highland"], "mimeType": "application/x-highland", "description": "Highland Screenplay", "rank": "Alternate" },
      { "ext": ["wdz"], "mimeType": "application/x-writerduet", "description": "WriterDuet Screenplay", "rank": "Alternate" },
