{
	email {$ACME_EMAIL}
}

{$DEMO_HOST} {
	encode gzip zstd
	# The admin console lives on the collab server; send /admin there instead
	# of letting the editor's catch-all render an empty page.
	@admin path /admin /admin/*
	redir @admin https://{$COLLAB_HOST}{uri} 302
	reverse_proxy demo:8080
}

{$COLLAB_HOST} {
	encode gzip zstd
	reverse_proxy collab:8080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}
